<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logomarca"
        android:label="atividade_somativa"
        android:roundIcon="@mipmap/logomarca"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ativ_somativ_2">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="lugares.ListaLugaresActivity" />

        <activity android:name="auth.LoginActivity" />

        <activity android:name="auth.CadastroUsuarioActivity" />

        <activity android:name="lugares.CadastroLugaresActivity" />

    </application>

</manifest>